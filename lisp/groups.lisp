;;; groups.lisp — Maxima functions for permutation groups

(in-package :maxima)

(defmvar $pgrp_max_elements 100000
  "pgrp_elements refuses groups larger than this.")

(defmacro with-cl-permutation-errors ((fn) &body body)
  "Turn errors from cl-permutation into Maxima errors naming FN."
  `(handler-case (progn ,@body)
     (error (e) (merror "~M: ~A" ',fn (princ-to-string e)))))

(defun perm-group-make (lists fn)
  "Build a handle from permutation lists, padding them to a common degree."
  (let* ((n (reduce #'max lists :key #'length :initial-value 1))
         (perms (mapcar (lambda (l)
                          (cl-permutation:list-to-perm (perm-list-fit l n)))
                        lists)))
    (%make-perm-group-handle
     (with-cl-permutation-errors (fn)
       (cl-permutation:generate-perm-group perms))
     n)))

(defun perm-group-generator-lists (handle)
  (mapcar #'cl-permutation:perm-to-list
          (cl-permutation:generators (perm-group-handle-group handle))))

(defun $pgrp (&rest args)
  "pgrp(p_1, ..., p_k) or pgrp([p_1, ..., p_k]): the group
   generated by the permutations p_i, each a list of images."
  ;; Evaluating a displayed handle passes the struct back in
  (when (and (= (length args) 1) (perm-group-handle-p (car args)))
    (return-from $pgrp (perm-group-wrap (car args))))
  (let ((gens (if (and (= (length args) 1)
                       ($listp (car args))
                       (every #'$listp (cdar args)))
                  (cdar args)
                  args)))
    (when (null gens)
      (merror "pgrp: needs at least one generator; use pgrp([1]) for the trivial group"))
    (perm-group-wrap
     (perm-group-make (mapcar (lambda (p) (perm-list-from-maxima p '$pgrp)) gens)
                      '$pgrp))))

(defun $pgrp_degree (g)
  (perm-group-handle-degree (perm-group-unwrap g '$pgrp_degree)))

(defun $pgrp_generators (g)
  (cons '(mlist simp)
        (mapcar (lambda (l) (cons '(mlist simp) l))
                (perm-group-generator-lists (perm-group-unwrap g '$pgrp_generators)))))

(defun $pgrp_order (g)
  (let ((h (perm-group-unwrap g '$pgrp_order)))
    (with-cl-permutation-errors ($pgrp_order)
      (cl-permutation:group-order (perm-group-handle-group h)))))

(defun perm-group-member-list-p (l handle)
  "Is the permutation list L an element of the group in HANDLE?"
  (let ((fitted (perm-list-fit l (perm-group-handle-degree handle))))
    (and fitted
         (cl-permutation:group-element-p (cl-permutation:list-to-perm fitted)
                                         (perm-group-handle-group handle)))))

(defun $pgrp_member_p (g p)
  "Is the permutation p an element of the group g?"
  (let ((h (perm-group-unwrap g '$pgrp_member_p))
        (l (perm-list-from-maxima p '$pgrp_member_p)))
    (with-cl-permutation-errors ($pgrp_member_p)
      (and (perm-group-member-list-p l h) t))))

(defun $pgrp_random (g)
  "A random element of the group g, uniformly distributed."
  (let ((h (perm-group-unwrap g '$pgrp_random)))
    (with-cl-permutation-errors ($pgrp_random)
      (perm-to-maxima (cl-permutation:random-group-element (perm-group-handle-group h))))))

(defun $pgrp_orbits (g)
  "The orbits of the group g on 1, ..., degree, each sorted, ordered by
   their least point."
  (let* ((h (perm-group-unwrap g '$pgrp_orbits))
         (orbits (with-cl-permutation-errors ($pgrp_orbits)
                   (cl-permutation:group-orbits (perm-group-handle-group h))))
         (lists (sort (mapcar (lambda (o) (sort (coerce o 'list) #'<)) orbits)
                      #'< :key #'first)))
    (cons '(mlist simp)
          (mapcar (lambda (l) (cons '(mlist simp) l)) lists))))

(defun $pgrp_subgroup_p (sub g)
  "Is the group sub a subgroup of the group g?"
  (let ((hs (perm-group-unwrap sub '$pgrp_subgroup_p))
        (hg (perm-group-unwrap g '$pgrp_subgroup_p)))
    (with-cl-permutation-errors ($pgrp_subgroup_p)
      (and (every (lambda (l) (perm-group-member-list-p l hg))
                  (perm-group-generator-lists hs))
           t))))

(defun $pgrp_normal_p (sub g)
  "Is the group sub a normal subgroup of the group g?"
  (let ((hs (perm-group-unwrap sub '$pgrp_normal_p))
        (hg (perm-group-unwrap g '$pgrp_normal_p)))
    (and ($pgrp_subgroup_p sub g)
         ;; Rebuild sub at g's degree so cl-permutation compares like with like
         (let* ((n (perm-group-handle-degree hg))
                (sub-n (perm-group-make
                        (mapcar (lambda (l) (perm-list-fit l n))
                                (perm-group-generator-lists hs))
                        '$pgrp_normal_p)))
           (with-cl-permutation-errors ($pgrp_normal_p)
             (and (cl-permutation:normal-subgroup-p (perm-group-handle-group hg)
                                                    (perm-group-handle-group sub-n))
                  t))))))

(defun perm-list< (a b)
  (loop :for x :in a :for y :in b
        :when (< x y) :return t
        :when (> x y) :return nil))

(defun $pgrp_elements (g)
  "All elements of the group g in lexicographic order. Refuses groups with
   more than pgrp_max_elements elements."
  (let* ((h (perm-group-unwrap g '$pgrp_elements))
         (group (perm-group-handle-group h))
         (order (cl-permutation:group-order group)))
    (when (> order $pgrp_max_elements)
      (merror "pgrp_elements: the group has ~M elements, more than pgrp_max_elements = ~M"
              order $pgrp_max_elements))
    (let ((elements '()))
      (with-cl-permutation-errors ($pgrp_elements)
        (cl-permutation:do-group-elements (p group)
          (push (cl-permutation:perm-to-list p) elements)))
      (cons '(mlist simp)
            (mapcar (lambda (l) (cons '(mlist simp) l))
                    (sort elements #'perm-list<))))))
