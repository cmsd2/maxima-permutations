;;; helpers.lisp — Element lists, subgroups from elements, conjugates and commutators
;;;
;;; Most structure functions work by brute force over a group's elements, which
;;; is fine up to pgrp_max_elements. Results that are groups come back as pgrp
;;; handles of the same degree as the group they came from.

(in-package :maxima)

(defun perm-group-element-lists (h fn)
  "All elements of the group in handle H as lists, in lexicographic order.
   Refuses groups larger than pgrp_max_elements."
  (let* ((group (perm-group-handle-group h))
         (order (cl-permutation:group-order group))
         (elements '()))
    (when (> order $pgrp_max_elements)
      (merror "~M: the group has ~M elements, more than pgrp_max_elements = ~M"
              fn order $pgrp_max_elements))
    (cl-permutation:do-group-elements (p group)
      (push (cl-permutation:perm-to-list p) elements))
    (sort elements #'perm-list<)))

(defun maxima-perm-lists (lists)
  (cons '(mlist simp) (mapcar (lambda (l) (cons '(mlist simp) l)) lists)))

(defun perm-group-from-lists (lists n fn)
  "A handle for the group generated by LISTS (permutations of degree N),
   with a small generating set chosen greedily: an element joins the
   generators only if the group so far doesn't contain it."
  (let ((gens '())
        (current nil)
        (identity (perm-list-identity n)))
    (dolist (l lists)
      (unless (or (equal l identity)
                  (and current (perm-group-member-list-p l current)))
        (setf gens (append gens (list l))
              current (perm-group-make gens fn))))
    (or current (perm-group-make (list identity) fn))))

(defun perm-list-at-degree (p n fn)
  "The Maxima permutation P as a list of degree N, or an error if it moves a
   point above N."
  (or (perm-list-fit (perm-list-from-maxima p fn) n)
      (merror "~M: ~M moves a point above the degree ~M" fn p n)))

(defun generator-lists-at-degree (x n fn)
  "X is a group or a list of permutations; return permutation lists of degree N."
  (cond ((perm-group-form-p x)
         (mapcar (lambda (l)
                   (or (perm-list-fit l n)
                       (merror "~M: ~M acts on more than ~M points" fn x n)))
                 (perm-group-generator-lists (cadr x))))
        (($listp x)
         (mapcar (lambda (p) (perm-list-at-degree p n fn)) (cdr x)))
        (t (merror "~M: expected a group or a list of permutations, got: ~M" fn x))))

(defun perm-list-conjugate (x g)
  "g x g^-1, the conjugate of X by G (D&F §2.2)."
  (perm-list-compose g (perm-list-compose x (perm-list-inverse g))))

(defun perm-list-commutator (x y)
  "[x, y] = x^-1 y^-1 x y (D&F §5.4)."
  (perm-list-compose (perm-list-inverse x)
                     (perm-list-compose (perm-list-inverse y)
                                        (perm-list-compose x y))))

(defun perm-list-element-order (l)
  (reduce #'lcm (perm-list-cycle-lengths l) :initial-value 1))

(defun perm-group-trivial-p (h)
  (= (cl-permutation:group-order (perm-group-handle-group h)) 1))

(defun perm-group-subgroup-handle-p (sub g)
  "Is the group in handle SUB contained in the group in handle G?"
  (every (lambda (l) (perm-group-member-list-p l g))
         (perm-group-generator-lists sub)))

(defun perm-group-normal-closure (g lists fn)
  "The smallest normal subgroup of G containing the permutation LISTS."
  (let* ((n (perm-group-handle-degree g))
         (ggens (perm-group-generator-lists g))
         (gens (remove-duplicates lists :test #'equal))
         (current (perm-group-from-lists gens n fn)))
    (loop
      (let ((new (loop :for x :in (perm-group-generator-lists current)
                       :append (loop :for h :in ggens
                                     :for c := (perm-list-conjugate x h)
                                     :unless (perm-group-member-list-p c current)
                                       :collect c))))
        (when (null new) (return current))
        (setf gens (append gens new)
              current (perm-group-from-lists gens n fn))))))

(defun perm-group-element-set (h fn)
  "The elements of H as a sorted list, for comparing subgroups."
  (perm-group-element-lists h fn))
