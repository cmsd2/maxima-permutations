;;; named.lisp — Standard groups and Cayley tables

(in-package :maxima)

(defun named-group-degree (n fn least)
  (unless (and (integerp n) (>= n least))
    (merror "~M: expected an integer at least ~M, got: ~M" fn least n))
  n)

(defun cycle-perm (cycle n)
  (cons '(mlist simp) (cycle-to-perm-list cycle n)))

(defun $pgrp_cyclic (n)
  "The cyclic group of order n, generated by (1 2 ... n)."
  (named-group-degree n '$pgrp_cyclic 1)
  ($pgrp (cycle-perm (perm-list-identity n) n)))

(defun $pgrp_dihedral (n)
  "D_2n, the symmetries of a regular n-gon with vertices 1, ..., n in order,
   as in D&F §1.2: generators r = (1 2 ... n), the rotation sending i to
   i+1, and s, the reflection fixing vertex 1 (i to n+2-i, mod n)."
  (named-group-degree n '$pgrp_dihedral 3)
  ($pgrp (cycle-perm (perm-list-identity n) n)
         (cons '(mlist simp)
               (loop :for i :from 1 :to n
                     :collect (1+ (mod (- (+ n 2) i 1) n))))))

(defun $pgrp_symmetric (n)
  "S_n, generated by (1 2) and (1 2 ... n)."
  (named-group-degree n '$pgrp_symmetric 1)
  (if (< n 2)
      ($pgrp ($pgrp_identity 1))
      ($pgrp (cycle-perm '(1 2) n) (cycle-perm (perm-list-identity n) n))))

(defun $pgrp_alternating (n)
  "A_n, generated by the 3-cycles (1 2 k) for k = 3, ..., n."
  (named-group-degree n '$pgrp_alternating 1)
  (if (< n 3)
      ($pgrp ($pgrp_identity n))
      (apply #'$pgrp (loop :for k :from 3 :to n :collect (cycle-perm (list 1 2 k) n)))))

;;; Q8 as left multiplication on its own elements. Element k of the list
;;; below is point k: 1 = 1, 2 = -1, 3 = i, 4 = -i, 5 = j, 6 = -j, 7 = k,
;;; 8 = -k. A unit is (sign . basis), basis one of 1, i, j, k.

(defparameter *quaternion-units*
  '((1 . 1) (-1 . 1) (1 . i) (-1 . i) (1 . j) (-1 . j) (1 . k) (-1 . k)))

(defun quaternion-basis-product (a b)
  "Product of two basis units as (sign . basis): ij = k, ji = -k, i^2 = -1."
  (cond ((eql a 1) (cons 1 b))
        ((eql b 1) (cons 1 a))
        ((eql a b) (cons -1 1))
        (t (let ((cyclic '((i . j) (j . k) (k . i)))
                 (third (first (set-difference '(i j k) (list a b)))))
             (cons (if (member (cons a b) cyclic :test #'equal) 1 -1) third)))))

(defun quaternion-unit-product (x y)
  (let ((p (quaternion-basis-product (cdr x) (cdr y))))
    (cons (* (car x) (car y) (car p)) (cdr p))))

(defun quaternion-left-multiplication (unit)
  (cons '(mlist simp)
        (loop :for x :in *quaternion-units*
              :collect (1+ (position (quaternion-unit-product unit x) *quaternion-units*
                                     :test #'equal)))))

(defun $pgrp_quaternion ()
  "Q_8 acting on itself by left multiplication, with points 1, ..., 8
   standing for 1, -1, i, -i, j, -j, k, -k. The generators are i and j."
  ($pgrp (quaternion-left-multiplication '(1 . i))
         (quaternion-left-multiplication '(1 . j))))

(defun $pgrp_cayley_table (elements &optional labels)
  "The Cayley table of a list of permutations, or of a group's elements.
   Row a, column b holds a∘b. Entries and headers are labels: the list
   given, or 1, 2, ... in the order of the elements. Fails if the list is
   not closed under composition."
  (let* ((elist (cond ((perm-group-form-p elements) (cdr ($pgrp_elements elements)))
                      (($listp elements) (cdr elements))
                      (t (merror "pgrp_cayley_table: expected a group or a list of permutations, got: ~M"
                                 elements))))
         (lists (mapcar (lambda (p) (perm-list-from-maxima p '$pgrp_cayley_table)) elist))
         (n (reduce #'max lists :key #'length :initial-value 1))
         (fitted (mapcar (lambda (l) (perm-list-fit l n)) lists))
         (names (cond ((null labels) (loop :for i :from 1 :to (length lists) :collect i))
                      ((and ($listp labels) (= (length (cdr labels)) (length lists)))
                       (cdr labels))
                      (t (merror "pgrp_cayley_table: expected ~M labels, got: ~M"
                                 (length lists) labels)))))
    (flet ((label-of (p)
             (let ((pos (position p fitted :test #'equal)))
               (unless pos
                 (merror "pgrp_cayley_table: the list is not closed: ~M is missing"
                         (cons '(mlist simp) p)))
               (nth pos names))))
      (apply #'$matrix
             (cons '(mlist simp) (cons '|$∘| names))
             (loop :for a :in fitted
                   :for name :in names
                   :collect (cons '(mlist simp)
                                  (cons name
                                        (loop :for b :in fitted
                                              :collect (label-of (perm-list-compose a b))))))))))
