;;; series.lisp — Derived and central series, composition series, Sylow
;;; subgroups, simplicity, direct products, abelian invariants, and the
;;; stabiliser chain behind pgrp_order

(in-package :maxima)

(defun group-list (handles)
  (cons '(mlist simp) (mapcar #'perm-group-wrap handles)))

(defun perm-group-order-of (h)
  (cl-permutation:group-order (perm-group-handle-group h)))

(defun perm-group-commutator-subgroup (a b ambient fn)
  "[A, B]: the normal closure in AMBIENT of the commutators of A's and B's
   generators. With A and B normal in AMBIENT this is the subgroup generated
   by all commutators [a, b]."
  (let ((n (perm-group-handle-degree ambient)))
    (perm-group-normal-closure
     ambient
     (loop :for x :in (perm-group-generator-lists a)
           :append (loop :for y :in (perm-group-generator-lists b)
                         :collect (perm-list-commutator (perm-list-fit x n) (perm-list-fit y n))))
     fn)))

(defun $pgrp_derived_subgroup (g)
  "The commutator subgroup g' = [g, g], generated by all x^-1 y^-1 x y."
  (let ((h (perm-group-unwrap g '$pgrp_derived_subgroup)))
    (perm-group-wrap (perm-group-commutator-subgroup h h h '$pgrp_derived_subgroup))))

(defun perm-group-derived-series (h fn)
  (let ((series (list h)))
    (loop
      (let* ((last (car series))
             (next (perm-group-commutator-subgroup last last last fn)))
        (when (= (perm-group-order-of next) (perm-group-order-of last))
          (return (nreverse series)))
        (push next series)))))

(defun $pgrp_derived_series (g)
  "g, g', g'', ... until it stops getting smaller."
  (group-list (perm-group-derived-series (perm-group-unwrap g '$pgrp_derived_series)
                                         '$pgrp_derived_series)))

(defun $pgrp_solvable_p (g)
  "Does the derived series reach the trivial group?"
  (let ((series (perm-group-derived-series (perm-group-unwrap g '$pgrp_solvable_p) '$pgrp_solvable_p)))
    (perm-group-trivial-p (car (last series)))))

(defun perm-group-lower-central-series (h fn)
  (let ((series (list h)))
    (loop
      (let* ((last (car series))
             (next (perm-group-commutator-subgroup last h h fn)))
        (when (= (perm-group-order-of next) (perm-group-order-of last))
          (return (nreverse series)))
        (push next series)))))

(defun $pgrp_lower_central_series (g)
  "g = G_1, G_2 = [G_1, g], G_3 = [G_2, g], ... until it stops getting smaller."
  (group-list (perm-group-lower-central-series (perm-group-unwrap g '$pgrp_lower_central_series)
                                               '$pgrp_lower_central_series)))

(defun $pgrp_nilpotent_p (g)
  "Does the lower central series reach the trivial group?"
  (let ((series (perm-group-lower-central-series (perm-group-unwrap g '$pgrp_nilpotent_p)
                                                 '$pgrp_nilpotent_p)))
    (perm-group-trivial-p (car (last series)))))

(defun $pgrp_composition_series (g)
  "g = G_0 > G_1 > ... > 1, each a normal subgroup of the one before with a
   simple quotient. Each step takes a largest proper normal subgroup, so
   keep g small."
  (let ((series (list (perm-group-unwrap g '$pgrp_composition_series))))
    (loop :until (perm-group-trivial-p (car series))
          :do (let* ((current (car series))
                     (proper (remove-if (lambda (s) (= (perm-group-order-of s) (perm-group-order-of current)))
                                        (perm-group-normal-subgroups current '$pgrp_composition_series))))
                (push (car (last proper)) series)))
    (group-list (nreverse series))))

(defun $pgrp_simple_p (g)
  "Is g non-trivial with no normal subgroups but 1 and g?"
  (let ((h (perm-group-unwrap g '$pgrp_simple_p)))
    (and (not (perm-group-trivial-p h))
         (= (length (perm-group-normal-subgroups h '$pgrp_simple_p)) 2))))

;;; Sylow subgroups

(defun prime-arg (p fn)
  (unless (and (integerp p) (> p 1) (primep p))
    (merror "~M: expected a prime, got: ~M" fn p))
  p)

(defun prime-power-p (m p)
  (loop :while (zerop (mod m p)) :do (setf m (/ m p)))
  (= m 1))

(defun perm-group-sylow (h p fn)
  "A Sylow p-subgroup of H, grown one element at a time: while P is not yet
   Sylow, some p-element outside P normalises it, and joining it gives a
   larger p-group."
  (let* ((n (perm-group-handle-degree h))
         (order (perm-group-order-of h))
         (target (loop :with m := 1 :while (zerop (mod (/ order m) p)) :do (setf m (* m p))
                       :finally (return m)))
         (p-elements (remove-if-not (lambda (x) (prime-power-p (perm-list-element-order x) p))
                                    (perm-group-element-lists h fn)))
         (current (perm-group-from-lists '() n fn)))
    (loop :while (< (perm-group-order-of current) target)
          :do (let ((grown nil))
                (dolist (x p-elements)
                  (unless (perm-group-member-list-p x current)
                    (let ((j (perm-group-from-lists (append (perm-group-generator-lists current) (list x))
                                                    n fn)))
                      (when (prime-power-p (perm-group-order-of j) p)
                        (setf current j grown t)
                        (return)))))
                (unless grown
                  (merror "~M: could not grow a Sylow ~M-subgroup; this is a bug" fn p))))
    current))

(defun $pgrp_sylow (g p)
  "A Sylow p-subgroup of g: a subgroup whose order is the largest power of p
   dividing the order of g."
  (perm-group-wrap (perm-group-sylow (perm-group-unwrap g '$pgrp_sylow) (prime-arg p '$pgrp_sylow)
                                     '$pgrp_sylow)))

(defun perm-group-sylow-subgroups (h p fn)
  (let* ((s (perm-group-sylow h p fn))
         (n (perm-group-handle-degree h))
         (seen (make-hash-table :test #'equal))
         (result '()))
    (dolist (x (perm-group-element-lists h fn))
      (let* ((conj (perm-group-from-lists (mapcar (lambda (y) (perm-list-conjugate y x))
                                                  (perm-group-generator-lists s))
                                          n fn))
             (key (perm-group-element-set conj fn)))
        (unless (gethash key seen)
          (setf (gethash key seen) t)
          (push conj result))))
    (nreverse result)))

(defun $pgrp_sylow_subgroups (g p)
  "All Sylow p-subgroups of g; by Sylow's theorems they are the conjugates of
   any one of them."
  (group-list (perm-group-sylow-subgroups (perm-group-unwrap g '$pgrp_sylow_subgroups)
                                          (prime-arg p '$pgrp_sylow_subgroups)
                                          '$pgrp_sylow_subgroups)))

(defun $pgrp_sylow_count (g p)
  "n_p, the number of Sylow p-subgroups of g."
  (length (perm-group-sylow-subgroups (perm-group-unwrap g '$pgrp_sylow_count)
                                      (prime-arg p '$pgrp_sylow_count)
                                      '$pgrp_sylow_count)))

;;; Products and abelian groups

(defun $pgrp_direct_product (g h)
  "g × h acting on disjoint points: g on 1, ..., m and h on m+1, ..., m+n."
  (let* ((a (perm-group-unwrap g '$pgrp_direct_product))
         (b (perm-group-unwrap h '$pgrp_direct_product))
         (m (perm-group-handle-degree a))
         (n (perm-group-handle-degree b)))
    (perm-group-wrap
     (perm-group-make
      (append (mapcar (lambda (l) (perm-list-fit l (+ m n))) (perm-group-generator-lists a))
              (mapcar (lambda (l) (append (perm-list-identity m) (mapcar (lambda (i) (+ i m)) l)))
                      (perm-group-generator-lists b)))
      '$pgrp_direct_product))))

(defun $pgrp_abelian_invariants (g)
  "For an abelian group g, the invariant factors [d_1, d_2, ...] with
   d_1 | d_2 | ..., so that g ≅ Z_d1 × Z_d2 × ... The trivial group gives []."
  (unless ($pgrp_abelian_p g)
    (merror "pgrp_abelian_invariants: the group is not abelian"))
  (let* ((h (perm-group-unwrap g '$pgrp_abelian_invariants))
         (orders (mapcar #'perm-list-element-order
                         (perm-group-element-lists h '$pgrp_abelian_invariants)))
         (size (length orders))
         (columns '()))
    ;; For each prime p, |{x : x^(p^k) = 1}| = p^(sum of min(lambda_i, k)),
    ;; which gives the number of cyclic factors of order at least p^k.
    (dolist (pair (if (= size 1) '() (cdr ($ifactors size))))
      (let* ((p (second pair))
             (f (lambda (k) (let ((count (count-if (lambda (o) (zerop (mod (expt p k) o))) orders))
                                  (e 0))
                              (loop :while (> count 1) :do (setf count (/ count p) e (1+ e)))
                              e)))
             (powers '()))
        (loop :for k :from 1
              :for at-least := (- (funcall f k) (funcall f (1- k)))
              :while (> at-least 0)
              :do (let ((exactly (- at-least (- (funcall f (1+ k)) (funcall f k)))))
                    (dotimes (i exactly) (push (expt p k) powers))))
        (push (sort powers #'>) columns)))
    ;; Invariant factor j is the product over primes of the j-th largest power
    (let* ((width (reduce #'max columns :key #'length :initial-value 0))
           (factors (loop :for j :from 0 :below width
                          :collect (reduce #'* (mapcar (lambda (c) (or (nth j c) 1)) columns)))))
      (cons '(mlist simp) (sort factors #'<)))))

;;; The stabiliser chain (Schreier–Sims) that cl-permutation keeps

(defun $pgrp_stabiliser_chain (g)
  "The stabiliser chain behind pgrp_order: a list of [k, orbit], from the
   highest point down, where orbit is the orbit of k under the subgroup
   fixing every point above k. The order is the product of the orbit sizes.
   Works without listing elements, so large groups are fine."
  (let* ((h (perm-group-unwrap g '$pgrp_stabiliser_chain))
         ;; Not exported by cl-permutation; group-order reads the same slot
         (trans (cl-permutation::perm-group.transversal-system (perm-group-handle-group h)))
         (steps '()))
    ;; Point k's transversal sits at index k - 1, as (j . sigma_kj) pairs
    (loop :for k :from 1 :to (length trans)
          :for sigma := (aref trans (1- k))
          :when (> (length sigma) 1)
            :do (push (list '(mlist simp) k
                            (cons '(mlist simp) (sort (mapcar #'car sigma) #'<)))
                      steps))
    (cons '(mlist simp) steps)))

(defun integer-partitions-desc (n &optional (largest n))
  "The partitions of N into parts no larger than LARGEST, parts in
   decreasing order."
  (if (zerop n)
      (list '())
      (loop :for part :from (min n largest) :downto 1
            :append (mapcar (lambda (rest) (cons part rest))
                            (integer-partitions-desc (- n part) part)))))

(defun $pgrp_abelian_groups (n)
  "Every abelian group of order n, as lists of invariant factors
   [d_1, ..., d_k] with d_1 | d_2 | ... | d_k, one list per group. Order 1
   gives [[]]. Lists with more factors come first."
  (unless (and (integerp n) (>= n 1))
    (merror "pgrp_abelian_groups: expected a positive integer, got: ~M" n))
  (if (= n 1)
      (list '(mlist simp) (list '(mlist simp)))
      (let* ((per-prime
               ;; For each prime, every way to split its exponent: lists of
               ;; prime powers, largest first
               (mapcar (lambda (pe)
                         (let ((p (second pe)) (e (third pe)))
                           (mapcar (lambda (part) (mapcar (lambda (k) (expt p k)) part))
                                   (integer-partitions-desc e))))
                       (cdr ($ifactors n))))
             (choices (reduce (lambda (acc options)
                                (loop :for a :in acc
                                      :append (mapcar (lambda (o) (append a (list o))) options)))
                              per-prime :initial-value (list '())))
             (groups (mapcar (lambda (choice)
                               (let ((width (reduce #'max choice :key #'length)))
                                 (sort (loop :for j :from 0 :below width
                                             :collect (reduce #'* (mapcar (lambda (powers) (or (nth j powers) 1))
                                                                          choice)))
                                       #'<)))
                             choices)))
        (cons '(mlist simp)
              (mapcar (lambda (l) (cons '(mlist simp) l))
                      (sort groups (lambda (a b)
                                     (or (> (length a) (length b))
                                         (and (= (length a) (length b)) (perm-list< a b))))))))))
