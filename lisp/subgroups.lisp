;;; subgroups.lisp — Subgroups, centralisers, cosets, quotients, conjugacy

(in-package :maxima)

(defun $pgrp_subgroup (g gens)
  "The subgroup of g generated by gens (a list of permutations), at g's
   degree. Fails if a generator is not in g."
  (let* ((h (perm-group-unwrap g '$pgrp_subgroup))
         (n (perm-group-handle-degree h))
         (lists (generator-lists-at-degree gens n '$pgrp_subgroup)))
    (dolist (l lists)
      (unless (perm-group-member-list-p l h)
        (merror "pgrp_subgroup: ~M is not in the group" (cons '(mlist simp) l))))
    (perm-group-wrap (perm-group-from-lists lists n '$pgrp_subgroup))))

(defun elements-where (h fn pred)
  (remove-if-not pred (perm-group-element-lists h fn)))

(defun $pgrp_centraliser (g a)
  "The elements of g that commute with every permutation in a (a list of
   permutations, or a group)."
  (let* ((h (perm-group-unwrap g '$pgrp_centraliser))
         (n (perm-group-handle-degree h))
         (as (generator-lists-at-degree a n '$pgrp_centraliser)))
    (perm-group-wrap
     (perm-group-from-lists
      (elements-where h '$pgrp_centraliser
                      (lambda (x) (every (lambda (y) (equal (perm-list-compose x y)
                                                            (perm-list-compose y x)))
                                         as)))
      n '$pgrp_centraliser))))

(defun $pgrp_normaliser (g k)
  "The elements x of g with x k x^-1 = k, for a subgroup k."
  (let* ((h (perm-group-unwrap g '$pgrp_normaliser))
         (hk (perm-group-unwrap k '$pgrp_normaliser))
         (n (perm-group-handle-degree h))
         (kgens (generator-lists-at-degree k n '$pgrp_normaliser)))
    (perm-group-wrap
     (perm-group-from-lists
      (elements-where h '$pgrp_normaliser
                      (lambda (x) (every (lambda (y) (perm-group-member-list-p (perm-list-conjugate y x) hk))
                                         kgens)))
      n '$pgrp_normaliser))))

(defun $pgrp_centre (g)
  "Z(g): the elements that commute with everything in g."
  ($pgrp_centraliser g g))

(defun $pgrp_abelian_p (g)
  "Do all elements of g commute? (It is enough that the generators do.)"
  (let ((gens (perm-group-generator-lists (perm-group-unwrap g '$pgrp_abelian_p))))
    (every (lambda (x) (every (lambda (y) (equal (perm-list-compose x y) (perm-list-compose y x)))
                              gens))
           gens)))

(defun $pgrp_cyclic_p (g)
  "Is g generated by a single element?"
  (let* ((h (perm-group-unwrap g '$pgrp_cyclic_p))
         (order (cl-permutation:group-order (perm-group-handle-group h))))
    (and (some (lambda (x) (= (perm-list-element-order x) order))
               (perm-group-element-lists h '$pgrp_cyclic_p))
         t)))

(defun $pgrp_subgroups (g)
  "Every subgroup of g, smallest first. Built from the cyclic subgroups by
   joining until nothing new appears, so keep g small."
  (let* ((h (perm-group-unwrap g '$pgrp_subgroups))
         (n (perm-group-handle-degree h))
         (elements (perm-group-element-lists h '$pgrp_subgroups))
         (seen (make-hash-table :test #'equal))
         (subgroups '()))
    (flet ((add (sub)
             (let ((key (perm-group-element-set sub '$pgrp_subgroups)))
               (unless (gethash key seen)
                 (setf (gethash key seen) t)
                 (push sub subgroups)
                 t))))
      (let ((cyclic '()))
        (dolist (x elements)
          (let ((c (perm-group-from-lists (list x) n '$pgrp_subgroups)))
            (when (add c) (push x cyclic))))
        (let ((frontier subgroups))
          (loop :while frontier
                :do (let ((new '()))
                      (dolist (sub frontier)
                        (dolist (x cyclic)
                          (unless (perm-group-member-list-p x sub)
                            (let ((j (perm-group-from-lists
                                      (append (perm-group-generator-lists sub) (list x))
                                      n '$pgrp_subgroups)))
                              (when (add j) (push j new))))))
                      (setf frontier new))))))
    (cons '(mlist simp)
          (mapcar #'perm-group-wrap
                  (stable-sort (nreverse subgroups) #'<
                               :key (lambda (s) (cl-permutation:group-order (perm-group-handle-group s))))))))

;;; Cosets

(defun subgroup-check (hsub h fn)
  (unless (perm-group-subgroup-handle-p hsub h)
    (merror "~M: the second group is not a subgroup of the first" fn)))

(defun cosets (g k fn side)
  (let* ((h (perm-group-unwrap g fn))
         (hk (perm-group-unwrap k fn))
         (n (perm-group-handle-degree h)))
    (subgroup-check hk h fn)
    (let ((kelements (mapcar (lambda (l) (perm-list-fit l n))
                             (perm-group-element-lists hk fn)))
          (covered (make-hash-table :test #'equal))
          (result '()))
      (dolist (x (perm-group-element-lists h fn))
        (unless (gethash x covered)
          (let ((coset (sort (mapcar (lambda (y) (if (eq side :left)
                                                     (perm-list-compose x y)
                                                     (perm-list-compose y x)))
                                     kelements)
                             #'perm-list<)))
            (dolist (c coset) (setf (gethash c covered) t))
            (push coset result))))
      (nreverse result))))

(defun $pgrp_left_cosets (g k)
  "The left cosets xk of the subgroup k in g, each sorted, in order of their
   least elements."
  (cons '(mlist simp) (mapcar #'maxima-perm-lists (cosets g k '$pgrp_left_cosets :left))))

(defun $pgrp_right_cosets (g k)
  "The right cosets kx of the subgroup k in g, each sorted, in order of their
   least elements."
  (cons '(mlist simp) (mapcar #'maxima-perm-lists (cosets g k '$pgrp_right_cosets :right))))

(defun $pgrp_index (g k)
  "[g : k], the number of cosets of the subgroup k in g."
  (let ((h (perm-group-unwrap g '$pgrp_index))
        (hk (perm-group-unwrap k '$pgrp_index)))
    (subgroup-check hk h '$pgrp_index)
    (/ (cl-permutation:group-order (perm-group-handle-group h))
       (cl-permutation:group-order (perm-group-handle-group hk)))))

;;; Quotients: g acting on the left cosets of a normal subgroup

(defun quotient-generator-images (g k fn)
  "The permutations of the left cosets of K induced by G's generators, and
   the cosets."
  (let* ((h (perm-group-unwrap g fn))
         (hk (perm-group-unwrap k fn)))
    (unless (perm-group-normal-in-p hk h)
      (merror "~M: the second group is not a normal subgroup of the first" fn))
    (let* ((cs (cosets g k fn :left))
           (index (make-hash-table :test #'equal)))
      (loop :for c :in cs :for i :from 1 :do (dolist (x c) (setf (gethash x index) i)))
      (values (mapcar (lambda (s) (mapcar (lambda (c) (gethash (perm-list-compose s (first c)) index)) cs))
                      (perm-group-generator-lists h))
              cs))))

(defun perm-group-normal-in-p (hk h)
  (let ((n (perm-group-handle-degree h)))
    (and (perm-group-subgroup-handle-p hk h)
         (every (lambda (y)
                  (every (lambda (x) (perm-group-member-list-p (perm-list-conjugate (perm-list-fit y n) x) hk))
                         (perm-group-generator-lists h)))
                (perm-group-generator-lists hk)))))

(defun $pgrp_quotient (g k)
  "g/k for a normal subgroup k, as the permutation group of g acting on the
   left cosets of k. Point i stands for the i-th coset of pgrp_left_cosets(g, k)."
  (let ((images (quotient-generator-images g k '$pgrp_quotient)))
    (perm-group-wrap (perm-group-make images '$pgrp_quotient))))

(defun $pgrp_quotient_hom (g k)
  "The homomorphism from g onto pgrp_quotient(g, k), sending x to the coset xk."
  (let* ((images (quotient-generator-images g k '$pgrp_quotient_hom))
         (q (perm-group-make images '$pgrp_quotient_hom)))
    `(($pgrp_hom simp)
      ,(perm-hom-make (perm-group-unwrap g '$pgrp_quotient_hom) q images '$pgrp_quotient_hom))))

;;; Conjugacy

(defun conjugacy-class (x elements)
  (sort (remove-duplicates (mapcar (lambda (g) (perm-list-conjugate x g)) elements) :test #'equal)
        #'perm-list<))

(defun $pgrp_conjugacy_class (g x)
  "The conjugacy class of x in g: every g y g^-1."
  (let* ((h (perm-group-unwrap g '$pgrp_conjugacy_class))
         (l (perm-list-at-degree x (perm-group-handle-degree h) '$pgrp_conjugacy_class)))
    (maxima-perm-lists (conjugacy-class l (perm-group-element-lists h '$pgrp_conjugacy_class)))))

(defun perm-group-conjugacy-classes (h fn)
  (let ((elements (perm-group-element-lists h fn))
        (covered (make-hash-table :test #'equal))
        (classes '()))
    (dolist (x elements)
      (unless (gethash x covered)
        (let ((c (conjugacy-class x elements)))
          (dolist (y c) (setf (gethash y covered) t))
          (push c classes))))
    (nreverse classes)))

(defun $pgrp_conjugacy_classes (g)
  "The conjugacy classes of g, each sorted, in order of their least
   elements; the identity's class comes first."
  (cons '(mlist simp)
        (mapcar #'maxima-perm-lists
                (perm-group-conjugacy-classes (perm-group-unwrap g '$pgrp_conjugacy_classes)
                                              '$pgrp_conjugacy_classes))))

;;; Normal subgroups

(defun $pgrp_normal_closure (g s)
  "The smallest normal subgroup of g containing s (a list of permutations
   or a group)."
  (let* ((h (perm-group-unwrap g '$pgrp_normal_closure))
         (lists (generator-lists-at-degree s (perm-group-handle-degree h) '$pgrp_normal_closure)))
    (dolist (l lists)
      (unless (perm-group-member-list-p l h)
        (merror "pgrp_normal_closure: ~M is not in the group" (cons '(mlist simp) l))))
    (perm-group-wrap (perm-group-normal-closure h lists '$pgrp_normal_closure))))

(defun perm-group-normal-subgroups (h fn)
  "Every normal subgroup of H as handles, smallest first: normal closures of
   single elements, joined until nothing new appears."
  (let* ((n (perm-group-handle-degree h))
         (seen (make-hash-table :test #'equal))
         (found '()))
    (flet ((add (sub)
             (let ((key (perm-group-element-set sub fn)))
               (unless (gethash key seen)
                 (setf (gethash key seen) t)
                 (push sub found)
                 t))))
      (let ((closures '()))
        (dolist (c (perm-group-conjugacy-classes h fn))
          (let ((nc (perm-group-normal-closure h (list (first c)) fn)))
            (when (add nc) (push nc closures))))
        (let ((frontier found))
          (loop :while frontier
                :do (let ((new '()))
                      (dolist (a frontier)
                        (dolist (b closures)
                          (unless (perm-group-subgroup-handle-p b a)
                            (let ((j (perm-group-from-lists
                                      (append (perm-group-generator-lists a) (perm-group-generator-lists b))
                                      n fn)))
                              (when (add j) (push j new))))))
                      (setf frontier new))))))
    (stable-sort (nreverse found) #'<
                 :key (lambda (s) (cl-permutation:group-order (perm-group-handle-group s))))))

(defun $pgrp_normal_subgroups (g)
  "Every normal subgroup of g, smallest first."
  (cons '(mlist simp)
        (mapcar #'perm-group-wrap
                (perm-group-normal-subgroups (perm-group-unwrap g '$pgrp_normal_subgroups)
                                             '$pgrp_normal_subgroups))))
