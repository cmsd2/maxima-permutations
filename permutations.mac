/* permutations -- permutation groups for Maxima, built on cl-permutation (SBCL only) */

if not is(build_info()@lisp_name = "SBCL") then
  error("permutations requires SBCL; current Lisp is", build_info()@lisp_name)$

load(if stringp(load_pathname)
       then sconcat(pathname_directory(load_pathname), "permutations-loader.lisp")
       else "permutations-loader.lisp")$
